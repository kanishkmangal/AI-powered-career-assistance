# Django Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL Database Configuration
# Option 1: Full Neon Connection String (Recommended)
# Found in your Neon Console (Dashboard -> Project -> Connection Details -> Connection string -> Django / PostgreSQL)
# Example format: postgresql://[user]:[password]@[neon-hostname].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Option 2: Individual Connection Parameters
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# CORS Configuration (React Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
